[Unit]
Description=Advance the frozen Nansen parallel-strategy prospective program
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/hdd/home/joel/Téléchargements/nansen-signal-lab
ExecStart=/mnt/hdd/home/joel/Téléchargements/nansen-signal-lab/.venv/bin/python /mnt/hdd/home/joel/Téléchargements/nansen-signal-lab/scripts/nansen_parallel_strategy_timer.py --manifest /mnt/hdd/home/joel/Téléchargements/nansen-signal-lab/research/experiments/2026-08-19-prospective-parallel-strategy-v1/program.json
EnvironmentFile=/mnt/hdd/home/joel/Téléchargements/nansen-signal-lab/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateUsers=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
RuntimeDirectory=nansen-signal-lab-parallel-strategy nansen-signal-lab-provider
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
ReadWritePaths=/mnt/hdd/home/joel/Téléchargements/nansen-signal-lab/research/experiments/2026-08-19-prospective-parallel-strategy-v1
ReadWritePaths=%t/nansen-signal-lab-parallel-strategy
ReadWritePaths=%t/nansen-signal-lab-provider
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
